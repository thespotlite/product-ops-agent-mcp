{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "domo-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["../reference/*.md"],
      "fallthrough": true
    }
  ],
  "d1_databases": [
    {
      "binding": "QUERY_LOG",
      "database_name": "domo-query-log",
      "database_id": "71f6356c-6ec9-40c7-90d8-b2a431c437fe"
    }
  ],
"kv_namespaces": [
  {
    "binding": "OAUTH_KV",
    "id": "9031eb402ffc4a028e886a4f4c7413f0"
  }
]
}
